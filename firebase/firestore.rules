rules_version = '2';
// Student portal — who may read and write what. Tested in tests/portal.test.mjs and tests/rules.edge.test.mjs;
// run `npm test` in this folder before publishing a change.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // config/coach is created by hand in the Firebase console and holds the coach's uid.
    function isCoach() {
      return signedIn()
        && get(/databases/$(database)/documents/config/coach).data.uid == request.auth.uid;
    }

    // A student's document id is their sign-in uid.
    function isActiveStudent() {
      return signedIn()
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true;
    }

    // Nobody writes this from the site, the coach included.
    match /config/{doc} {
      allow read: if isCoach();
      allow write: if false;
    }

    match /students/{uid} {
      allow read: if isCoach() || (signedIn() && request.auth.uid == uid);
      allow write: if isCoach();
    }

    match /series/{id} {
      allow read, write: if isCoach();
    }

    // Free-assessment requests from the public form on the home page. Anyone may add one
    // well-formed request; only the coach can see, change or remove them.
    match /demoRequests/{id} {
      allow create: if demoOk(request.resource.data);
      allow read, update, delete: if isCoach();

      function demoOk(d) {
        return d.keys().hasOnly(['childName', 'age', 'played', 'preferredTime', 'parentName', 'mobile', 'lang', 'status', 'createdAt'])
          && d.keys().hasAll(['childName', 'age', 'played', 'preferredTime', 'parentName', 'mobile', 'lang', 'status', 'createdAt'])
          && d.childName is string && d.childName.size() >= 1 && d.childName.size() <= 40
          && d.age is int && d.age >= 4 && d.age <= 15
          && d.played is string && d.played.size() <= 40
          && d.preferredTime is string && d.preferredTime.size() <= 40
          && d.parentName is string && d.parentName.size() >= 1 && d.parentName.size() <= 60
          && d.mobile is string && d.mobile.matches('^[+]?[0-9]{10,15}$')
          && d.lang in ['en', 'hi']
          && d.status == 'new'
          && d.createdAt == request.time;
      }
    }

    match /sessions/{id} {
      allow read: if isCoach()
        || (isActiveStudent() && request.auth.uid in resource.data.studentIds);
      allow create, delete: if isCoach();
      // A student may stamp their own join time, and add or remove their own "can't attend"
      // note until 2 hours before the start. Nothing else.
      allow update: if isCoach()
        || (isActiveStudent()
            && request.auth.uid in resource.data.studentIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joins', 'absences', 'homeworkDone'])
            && joinsOk() && absencesOk() && homeworkDoneOk());

      function changed(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys();
      }
      function joinsOk() {
        return changed('joins').size() == 0
          || (changed('joins').hasOnly([request.auth.uid])
              && request.resource.data.joins[request.auth.uid] == request.time);
      }
      function absencesOk() {
        return changed('absences').size() == 0
          || (changed('absences').hasOnly([request.auth.uid])
              && resource.data.status == 'scheduled'
              && request.time < resource.data.startsAt - duration.value(2, 'h')
              && (!(request.auth.uid in request.resource.data.get('absences', {}))
                  || noteOk(request.resource.data.absences[request.auth.uid])));
      }
      // Homework: own tick only, only on a class that carries homework (which only the coach
      // can write); the tick is the time it was made.
      function homeworkDoneOk() {
        return changed('homeworkDone').size() == 0
          || (changed('homeworkDone').hasOnly([request.auth.uid])
              && resource.data.get('homework', null) != null
              && (!(request.auth.uid in request.resource.data.get('homeworkDone', {}))
                  || request.resource.data.homeworkDone[request.auth.uid] == request.time));
      }
      function noteOk(note) {
        return note.keys().hasOnly(['at', 'reason'])
          && note.at == request.time
          && note.reason is string && note.reason.size() <= 200;
      }
    }
  }
}
